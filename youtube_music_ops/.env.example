# Copy to /root/.hermes/.env (the path the scripts in this folder read by
# default — see ENV_FILE in run_daily_opportunity_radar.py /
# run_multi_niche_discovery_2026_08_06.py) or export these vars directly.
#
# Without TRANSCRIPT_API_KEY, both scripts fall back automatically to a
# yt-dlp-based flat search (labeled "yt-dlp-flat-search" / "discovery_only"
# in their output) — degraded but functional, no crash.

TRANSCRIPT_API_KEY=

# Optional: override where scripts resolve config/output from.
# Defaults to the parent of scripts/ (i.e. this youtube_music_ops/ folder).
# MUSIC_OPS_ROOT=/path/to/youtube_music_ops
